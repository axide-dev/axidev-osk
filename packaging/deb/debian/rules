#!/usr/bin/make -f

export PYBUILD_NAME=axidev-osk

%:
	dh $@ --with python3

override_dh_auto_build:
	python3 -m build --wheel --no-isolation --outdir dist vendor/axidev-io-python
	python3 -m build --wheel --no-isolation --outdir dist .

override_dh_auto_install:
	python3 -m installer --destdir=debian/axidev-osk dist/axidev_io-*.whl
	python3 -m installer --destdir=debian/axidev-osk dist/axidev_osk-*.whl
	install -Dm0644 packaging/linux/resources/70-axidev-io-uinput.rules \
		debian/axidev-osk/lib/udev/rules.d/70-axidev-io-uinput.rules
